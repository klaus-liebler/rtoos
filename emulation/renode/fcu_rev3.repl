// SPDX-License-Identifier: MIT
//
// Factory Control Unit revision 3 (factory_in_a_box/pcb_factory_control_unit, MCU U17:
// STM32H743VIT6) for Renode.
//   Console  USART3 (PD8/PD9 -> ST-LINK VCP)
//   LED      LED_INFO on PE1, active low
//   Ethernet LAN8742A at MDIO address 0 (the register values of fcu.repl, revision 1/2):
//            link up, 100BASE-TX full duplex
//   SD card  SDMMC1 (the STM32H5 SDMMC model: the same SDMMC v2 registers, STM32H5_SDMMC.cs,
//            fcu_rev3.resc compiles it); a card is inserted at run time:
//              sysbus.sdmmc1 InsertCard @<image> <true: SDHC | false: SDSC>
using "stm32h743.repl"

// SDMMC1: SVD v2.4 address, IRQ 49 (stm32h743xx.h SDMMC1_IRQn)
sdmmc1: SD.STM32H5_SDMMC @ sysbus 0x52007000
    IRQ -> nvic@49

led_info: Miscellaneous.LED @ gpioPortE 1
    invert: true

gpioPortE:
    1 -> led_info@0

phy: Network.EthernetPhysicalLayer @ ethernet 0
    BasicControl: 0x3100
    BasicStatus: 0x782D
    Id1: 0x0007
    Id2: 0xC130
    AutoNegotiationAdvertisement: 0x01E1
    AutoNegotiationLinkPartnerBasePageAbility: 0x0001
    AutoNegotiationExpansion: 0x0064
    AutoNegotiationNextPageTransmit: 0x2001
    // PHYSCSR (reg 31): autonegotiation done, HCDSPEED = 110 (100BASE-TX full duplex)
    VendorSpecific15: 0x1058
