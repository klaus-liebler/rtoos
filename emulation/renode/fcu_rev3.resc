:name: Factory Control Unit revision 3 (STM32H743)
:description: rtoos firmware on the Factory Control Unit revision 3. Set $bin to the ELF to run.

$name?="fcu_rev3"
$bin?=@build/arm-h743/apps/stm32h743/net/fcu_net.elf

using sysbus
mach create $name
include $ORIGIN/STM32H7_FLASH.cs
include $ORIGIN/STM32H5_SDMMC.cs
include $ORIGIN/STM32_OTG_FS.cs
machine LoadPlatformDescription $ORIGIN/fcu_rev3.repl

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x08000000
"""
runMacro $reset
