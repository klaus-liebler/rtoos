// SPDX-License-Identifier: MIT
//
// STM32F103xB (Cortex-M3, 128 KB flash, 20 KB SRAM) for Renode, as a bare chip.
// Addresses and IRQ numbers: RM0008 rev 21 / ST's stm32f103xb.h.
//
// Modelled: core (NVIC with 4 priority bits, SysTick, DWT cycle counter), flash, SRAM, system
// memory (UID, flash size; zero-filled), RCC (register file with ready/status flags), FLASH_ACR,
// GPIOA..E and AFIO (Renode's F1 models), USART1..3, I2C1/2 (Renode's STM32F1_I2C), TIM1-4 (time
// base and update interrupt).
// Tagged (reads 0, writes logged): bxCAN, IWDG, EXTI, DBGMCU.
//
// Clock: the self-test runs SYSCLK = HCLK = 64 MHz from the HSI PLL (APB1 32 MHz, timers
// 64 MHz); the CPU executes 64 MIPS (CPI 1), so cycle counts from DWT_CYCCNT are consistent with
// SysTick but not cycle-accurate.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic
    PerformanceInMips: 64

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    // SysTick with CLKSOURCE = processor clock: SYSCLK = 64 MHz
    systickFrequency: 64000000
    IRQ -> cpu@0

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 64000000

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x5000

// System memory: flash size at 0x1FFFF7E0, UID at 0x1FFFF7E8; zero-filled
system: Memory.MappedMemory @ sysbus 0x1FFFF000
    size: 0x1000

usart1: UART.STM32_UART @ sysbus <0x40013800, +0x100>
    -> nvic@37

usart2: UART.STM32_UART @ sysbus <0x40004400, +0x100>
    -> nvic@38

usart3: UART.STM32_UART @ sysbus <0x40004800, +0x100>
    -> nvic@39

i2c1: I2C.STM32F1_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

i2c2: I2C.STM32F1_I2C @ sysbus 0x40005800
    EventInterrupt -> nvic@33
    ErrorInterrupt -> nvic@34

// Timers: Renode's STM32 timer model (PSC, ARR, CNT, update event and interrupt, CEN, UG);
// compare outputs and the encoder interface are not modelled. Timer clock 64 MHz.
tim1: Timers.STM32_Timer @ sysbus 0x40012C00
    frequency: 64000000
    initialLimit: 0xFFFF
    UpdateInterrupt -> nvic@25

tim2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@28

tim3: Timers.STM32_Timer @ sysbus 0x40000400
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@29

tim4: Timers.STM32_Timer @ sysbus 0x40000800
    frequency: 64000000
    initialLimit: 0xFFFF
    -> nvic@30

gpioPortA: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010800, +0x400>

gpioPortB: GPIOPort.STM32F1GPIOPort @ sysbus <0x40010C00, +0x400>

gpioPortC: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011000, +0x400>

gpioPortD: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011400, +0x400>

gpioPortE: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011800, +0x400>

// Ports F and G do not exist on the F103x8/xB; Renode's AFIO model needs seven ports
gpioPortF: GPIOPort.STM32F1GPIOPort @ sysbus <0x40011C00, +0x400>

gpioPortG: GPIOPort.STM32F1GPIOPort @ sysbus <0x40012000, +0x400>

afio: GPIOPort.STM32F1AFIO @ sysbus 0x40010000
    gpioPorts: [gpioPortA, gpioPortB, gpioPortC, gpioPortD, gpioPortE, gpioPortF, gpioPortG]

// RCC: plain register file with the hardware's reset values (RM0008 7.3). Ready flags follow
// their enable bits immediately (CR: HSIRDY, HSERDY, PLLRDY; CSR: LSIRDY), CFGR.SWS mirrors
// CFGR.SW, CSR.RMVF clears the reset flags. Must match QEMU's stm32f1_sysctl.c.
rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x000: 0x00000083, 0x014: 0x00000014, 0x024: 0x0C000000}
elif request.IsWrite:
    value = request.Value & 0xFFFFFFFF
    if request.Offset == 0x000:
        for on, rdy in ((0, 1), (16, 17), (24, 25)):
            if value & (1 << on):
                value = value | (1 << rdy)
            else:
                value = value & ~(1 << rdy)
    elif request.Offset == 0x004:
        value = (value & ~(3 << 2)) | ((value & 3) << 2)
    elif request.Offset == 0x024:
        value = (value | 2) if value & 1 else (value & ~2)
        if value & (1 << 24):
            value = value & 0x00FFFFFF
    regs[request.Offset] = value
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''

// FLASH interface: ACR as a register file (reset 0x30: prefetch on and active; the new latency
// reads back at once).
flashInterface: Python.PythonPeripheral @ sysbus 0x40022000
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x000: 0x00000030}
elif request.IsWrite:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''

sysbus:
    init:
        Tag <0x40006400 0x400> "bxCAN"
        Tag <0x40003000 0x400> "IWDG"
        Tag <0x40010400 0x400> "EXTI"
        Tag <0xE0042000 0x400> "DBGMCU"
