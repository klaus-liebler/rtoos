// SPDX-License-Identifier: MIT
//
// STM32H563xI (Cortex-M33, 2 MB flash, 640 KB SRAM) for Renode.
// Addresses and IRQ numbers: ST SVD STM32H563 v1.8 / RM0481.
//
// Modelled: core (NVIC, SysTick, DWT cycle counter, MPU, FPU), flash, SRAM, RCC
// (register file with ready/status flags), PWR voltage scaling, FLASH_ACR,
// GPIOA..I, USART1..3, SPI1..4, SDMMC1, TIM2-5/15-17 (compare outputs, DMA requests), GPDMA1, Ethernet MAC (Synopsys DWC EQoS, same IP and register layout
// as the STM32H7), RNG, UID/package data area.
// Tagged (reads 0, writes logged): ICACHE, DCACHE1, rest of the FLASH interface,
// SBS, EXTI. A read of 0 means "not busy" for the cache status registers, so the
// cache drivers run unchanged.
//
// Clock: the firmware runs SYSCLK = HCLK = PCLK2/3 = 250 MHz from PLL1, PCLK1 = 125 MHz
// (boards/fcu: APB1 / 2; the APB1 timers run at 2 x PCLK1 = 250 MHz). Frequencies below follow; the CPU executes 250 MIPS (CPI 1), so
// cycle counts from DWT_CYCCNT are consistent with SysTick but not cycle-accurate.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic
    numberOfMPURegions: 8
    PerformanceInMips: 250

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    // SysTick with CLKSOURCE = processor clock: SYSCLK = 250 MHz
    systickFrequency: 250000000
    IRQ -> cpu@0

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 250000000

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x200000

// SRAM1 (256 KB) + SRAM2 (64 KB) + SRAM3 (320 KB), contiguous
sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0xA0000

// Read-only system data (UID at 0x08FFF800, package, flash size); zero-filled
uid: Memory.MappedMemory @ sysbus 0x08FFF000
    size: 0x1000

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 250000000
    IRQ -> nvic@58

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 125000000
    IRQ -> nvic@59

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 125000000
    IRQ -> nvic@60

// Timers: own model STM32H5_TIM.cs (fcu.resc compiles it): up-counting with period ARR + 1,
// preload, one-pulse mode, compare outputs ChX (toggle, PWM, ...), update/compare DMA requests
// to GPDMA1 (request numbers GPDMA1_REQUEST_*). Timer clock 250 MHz: 2 x PCLK1 (APB1 / 2) and
// PCLK2. The compare outputs are wired to pins where a platform needs them (tests).
tim2: Timers.STM32H5_TIM @ sysbus 0x40000000
    frequency: 250000000
    counterWidth: 32
    IRQ -> nvic@45
    DmaCc1 -> gpdma1@72
    DmaCc2 -> gpdma1@73
    DmaCc3 -> gpdma1@74
    DmaCc4 -> gpdma1@75
    DmaUpdate -> gpdma1@76

tim3: Timers.STM32H5_TIM @ sysbus 0x40000400
    frequency: 250000000
    IRQ -> nvic@46
    DmaCc1 -> gpdma1@77
    DmaCc2 -> gpdma1@78
    DmaCc3 -> gpdma1@79
    DmaCc4 -> gpdma1@80
    DmaUpdate -> gpdma1@81

tim4: Timers.STM32H5_TIM @ sysbus 0x40000800
    frequency: 250000000
    IRQ -> nvic@47
    DmaCc1 -> gpdma1@83
    DmaCc2 -> gpdma1@84
    DmaCc3 -> gpdma1@85
    DmaCc4 -> gpdma1@86
    DmaUpdate -> gpdma1@87

tim5: Timers.STM32H5_TIM @ sysbus 0x40000C00
    frequency: 250000000
    counterWidth: 32
    IRQ -> nvic@48

tim15: Timers.STM32H5_TIM @ sysbus 0x40014000
    frequency: 250000000
    channels: 2
    IRQ -> nvic@71
    DmaCc1 -> gpdma1@94
    DmaUpdate -> gpdma1@95

tim16: Timers.STM32H5_TIM @ sysbus 0x40014400
    frequency: 250000000
    channels: 1
    IRQ -> nvic@72
    DmaCc1 -> gpdma1@98
    DmaUpdate -> gpdma1@99

tim17: Timers.STM32H5_TIM @ sysbus 0x40014800
    frequency: 250000000
    channels: 1
    IRQ -> nvic@73
    DmaCc1 -> gpdma1@100
    DmaUpdate -> gpdma1@101

// GPDMA1: own model STM32H5_GPDMA.cs: channels 0-7, linear blocks, hardware requests from the
// timers above, software requests (memory to memory).
gpdma1: DMA.STM32H5_GPDMA @ sysbus 0x40020000
    [0-7] -> nvic@[27-34]

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x42020000, +0x400>
    modeResetValue: 0xABFFFFFF
    outputSpeedResetValue: 0x0C000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x42020400, +0x400>
    modeResetValue: 0xFFFFFEBF
    outputSpeedResetValue: 0x000000C0
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x42020800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x42020C00, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x42021000, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x42021400, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x42021800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x42021C00, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

gpioPortI: GPIOPort.STM32_GPIOPort @ sysbus <0x42022000, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16

// SDMMC1 with an SD card: own model STM32H5_SDMMC.cs (IDMA, R7 check pattern; fcu.resc
// compiles it). The card is inserted at run time:
//   sysbus.sdmmc1 InsertCard @<image> <true: SDHC | false: SDSC>
sdmmc1: SD.STM32H5_SDMMC @ sysbus 0x46008000
    IRQ -> nvic@79

// SPI1-4: own model STM32H5_SPI.cs (fcu.resc compiles it): master, bit-timed MOSI/SCK/MISO
// as GPIOs, FIFOs of 16 frames (SPI1-3) and 8 frames (SPI4). Kernel clocks as the board sets
// them: pll1_q = 100 MHz for SPI1-3 (RCC_CCIPR3 reset selection), PCLK2 = 250 MHz for SPI4.
spi1: SPI.STM32H5_SPI @ sysbus 0x40013000
    kernelFrequency: 100000000
    fifoSize: 16
    IRQ -> nvic@55

spi2: SPI.STM32H5_SPI @ sysbus 0x40003800
    kernelFrequency: 100000000
    fifoSize: 16
    IRQ -> nvic@56

spi3: SPI.STM32H5_SPI @ sysbus 0x40003C00
    kernelFrequency: 100000000
    fifoSize: 16
    IRQ -> nvic@57

spi4: SPI.STM32H5_SPI @ sysbus 0x40014C00
    kernelFrequency: 250000000
    fifoSize: 8
    IRQ -> nvic@82

// Note: with MACCR.SARC = 000 the model logs "Attempted to use external MAC address"
// for every TX frame and leaves the frame unchanged - which is what the STM32
// does (the source-address control inputs are tied inactive). Harmless.
ethernet: Network.SynopsysDWCEthernetQualityOfService @ {
        sysbus 0x40028000;
        sysbus new Bus.BusMultiRegistration { address: 0x40028C00; size: 0x200; region: "mtl" };
        sysbus new Bus.BusMultiRegistration { address: 0x40029000; size: 0x200; region: "dma" }
    }
    systemClockFrequency: 250000000
    dmaBusWidth: BusWidth.Bits32
    -> nvic@106

rng: Miscellaneous.STM32_RNG @ sysbus 0x420C0800
    series: STM32Series.L5
    -> nvic@114

// RCC: plain register file with the hardware's reset values. Ready flags follow
// their enable bits immediately (HSIRDY, CSIRDY, HSI48RDY, HSERDY, PLLxRDY),
// HSIDIVF is always set (divider change applied), CFGR1.SWS mirrors CFGR1.SW.
rcc: Python.PythonPeripheral @ sysbus 0x44020C00
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x000: 0x00000023, 0x010: 0x00400000, 0x018: 0x00200000,
            0x034: 0x01010280, 0x03C: 0x01010280, 0x044: 0x01010280,
            0x088: 0xD0000100, 0x08C: 0xC0000000,
            0x0B0: 0xF13AD103, 0x0B4: 0xC01F1DFF, 0x0BC: 0x00111880, 0x0C4: 0xDFFEC9FF,
            0x0C8: 0x4080022B, 0x0CC: 0x017F7800, 0x0D0: 0x0030F9E2, 0x0F4: 0x0C000000}
elif request.IsWrite:
    value = request.Value & 0xFFFFFFFF
    if request.Offset == 0x000:
        for on in (0, 8, 12, 16, 24, 26, 28):
            if value & (1 << on):
                value = value | (1 << (on + 1))
            else:
                value = value & ~(1 << (on + 1))
        value = value | (1 << 5)
    elif request.Offset == 0x01C:
        value = (value & ~(7 << 3)) | ((value & 7) << 3)
    regs[request.Offset] = value
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''

// PWR: VOSCR + VOSSR (SVD reset 0x08). A new voltage scale is ready at once:
// VOSRDY = ACTVOSRDY = 1, ACTVOS mirrors VOS.
pwr: Python.PythonPeripheral @ sysbus 0x44020800
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x014: 0x00000008}
elif request.IsWrite:
    value = request.Value & 0xFFFFFFFF
    regs[request.Offset] = value
    if request.Offset == 0x010:
        regs[0x014] = (1 << 3) | (1 << 13) | (((value >> 4) & 3) << 14)
elif request.IsRead:
    request.Value = regs.get(request.Offset, 0)
'''

// DTS temperature sensor, as measured on the FCU (SWD register dumps): TS1_START = 1 measures
// continuously - TS1_RDY reads 0, DR follows the temperature; TS1_START = 0: TS1_RDY = 1 (when
// enabled), DR keeps the last count (0 before the first measurement). Fixed temperature: the
// FCU's sensor at about 28.6 degC (FM 716.625 kHz) counted with PCLK1 = 125 MHz; factory values
// T0VALR1 = 0x1C1B, RAMPVALR = 0x7CB of that chip. Must match QEMU's stm32h5_sysctl.c.
dts: Python.PythonPeripheral @ sysbus 0x40008C00
    size: 0x400
    initable: true
    script: '''
if request.IsInit:
    regs = {0x08: 0x00001C1B, 0x10: 0x000007CB}
elif request.IsWrite:
    regs[request.Offset] = request.Value & 0xFFFFFFFF
    cfgr1 = regs.get(0x00, 0)
    if (cfgr1 & 0x11) == 0x11:
        smp = (cfgr1 >> 16) & 0xF
        regs[0x1C] = 125000000 * (smp if smp else 1) // 716625
elif request.IsRead:
    cfgr1 = regs.get(0x00, 0)
    if request.Offset == 0x20:
        request.Value = (1 << 15) if (cfgr1 & 0x11) == 0x01 else 0
    else:
        request.Value = regs.get(request.Offset, 0)
'''

// FLASH interface: own model STM32H5_FLASH.cs (fcu.resc compiles it): ACR, unlock keys, sector
// erase; the CPU programs by writing to the flash memory.
flashController: MTD.STM32H5_FLASH @ sysbus 0x40022000
    flashBase: 0x08000000
    flashSize: 0x200000

sysbus:
    init:
        Tag <0x40030400 0x400> "ICACHE"
        Tag <0x40031400 0x400> "DCACHE1"
        Tag <0x44000400 0x400> "SBS"
        Tag <0x44022000 0x400> "EXTI"
        Tag <0x44024000 0x400> "DBGMCU"
