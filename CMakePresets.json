{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc16",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "RTOS_GCC_ROOT": "C:/opt/msys64/ucrt64",
        "RTOS_CA_CERT": "C:/Users/klaus/OneDrive - HSOS/certificates/rtoosCA.pem.crt",
        "RTOS_CA_KEY": "C:/Users/klaus/OneDrive - HSOS/certificates/rtoosCA.pem.key"
      },
      "environment": {
        "PATH": "C:/opt/msys64/ucrt64/bin;$penv{PATH}"
      }
    },
    {
      "name": "host",
      "inherits": "gcc16",
      "displayName": "Host unit tests (GCC 16)",
      "binaryDir": "${sourceDir}/build/host",
      "toolchainFile": "${sourceDir}/cmake/gcc-host.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "arm-base",
      "hidden": true,
      "inherits": "gcc16",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_CONTRACT_SEMANTIC": "quick_enforce"
      }
    },
    {
      "name": "arm",
      "inherits": "arm-base",
      "displayName": "STM32H563 firmware for the emulators (QEMU, Renode) + emulator tests",
      "binaryDir": "${sourceDir}/build/arm",
      "cacheVariables": {
        "RTOS_QEMU": "C:/opt/qemu-stm32h5/qemu-system-arm.exe",
        "RTOS_RENODE": "C:/opt/renode/renode.exe",
        "RTOS_NET_SNTP_PORT": "12300",
        "RTOS_NET_STATIC_FALLBACK": "192.168.77.2/24,192.168.77.1"
      }
    },
    {
      "name": "board",
      "inherits": "arm-base",
      "displayName": "STM32H563 firmware for the real Factory Control Unit (real network)",
      "binaryDir": "${sourceDir}/build/board"
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "arm",
      "configurePreset": "arm"
    },
    {
      "name": "board",
      "configurePreset": "board"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "arm",
      "configurePreset": "arm",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
