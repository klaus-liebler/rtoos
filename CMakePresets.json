{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc16",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "RTOS_GCC_ROOT": "C:/opt/msys64/ucrt64",
        "RTOS_CA_CERT": "C:/Users/klaus/OneDrive - HSOS/certificates/rtoosCA.pem.crt",
        "RTOS_CA_KEY": "C:/Users/klaus/OneDrive - HSOS/certificates/rtoosCA.pem.key"
      },
      "environment": {
        "PATH": "C:/opt/msys64/ucrt64/bin;$penv{PATH}"
      }
    },
    {
      "name": "host",
      "inherits": "gcc16",
      "displayName": "Host unit tests (GCC 16)",
      "binaryDir": "${sourceDir}/build/host",
      "toolchainFile": "${sourceDir}/cmake/gcc-host.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-coverage",
      "inherits": "host",
      "displayName": "Host unit tests with gcov instrumentation (gcovr report in build/coverage)",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage -O0 -fprofile-update=atomic",
        "CMAKE_CXX_FLAGS": "--coverage -O0 -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "generator": "Ninja",
      "description": "Linux host (tools/fuzz/Dockerfile: GCC 16 + AFL++), see docs/fuzzing.md",
      "cacheVariables": {
        "RTOS_GCC_ROOT": "/usr",
        "RTOS_CERT_DIR": "${sourceDir}/build/${presetName}/certs",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "RTOS_HOST_SANITIZERS": "address"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux",
      "displayName": "Host unit tests under ASan + UBSan (Linux, GCC 16)",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTOS_FUZZ": "ON"
      }
    },
    {
      "name": "linux-afl",
      "inherits": "linux",
      "displayName": "AFL++ fuzzing harnesses with ASan + UBSan (Linux, GCC 16)",
      "binaryDir": "${sourceDir}/build/linux-afl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "afl-gcc-fast",
        "CMAKE_CXX_COMPILER": "afl-g++-fast",
        "RTOS_FUZZ": "ON"
      }
    },
    {
      "name": "arm-base",
      "hidden": true,
      "inherits": "gcc16",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_CONTRACT_SEMANTIC": "quick_enforce"
      }
    },
    {
      "name": "arm",
      "inherits": "arm-base",
      "displayName": "STM32H563 firmware for the emulators (QEMU, Renode) + emulator tests",
      "binaryDir": "${sourceDir}/build/arm",
      "cacheVariables": {
        "RTOS_QEMU": "C:/opt/qemu-stm32h5/qemu-system-arm.exe",
        "RTOS_RENODE": "C:/opt/renode/renode.exe",
        "RTOS_NET_SNTP_PORT": "12300",
        "RTOS_NET_STATIC_FALLBACK": "192.168.77.2/24,192.168.77.1",
        "RTOS_NET_WS_PING_MS": "4000",
        "RTOS_NET_WS_PONG_TIMEOUT_MS": "3000"
      }
    },
    {
      "name": "board",
      "inherits": "arm-base",
      "displayName": "STM32H563 firmware for the real Factory Control Unit (real network)",
      "binaryDir": "${sourceDir}/build/board"
    },
    {
      "name": "arm-g431",
      "inherits": "arm-base",
      "displayName": "STM32G431 firmware for the emulators (QEMU, Renode) + emulator tests",
      "binaryDir": "${sourceDir}/build/arm-g431",
      "cacheVariables": {
        "RTOS_CHIP": "stm32g431",
        "RTOS_QEMU": "C:/opt/qemu-stm32h5/qemu-system-arm.exe",
        "RTOS_RENODE": "C:/opt/renode/renode.exe"
      }
    }
,
    {
      "name": "arm-f103",
      "inherits": "arm-base",
      "displayName": "STM32F103 firmware for the emulators (QEMU, Renode) + emulator tests",
      "binaryDir": "${sourceDir}/build/arm-f103",
      "cacheVariables": {
        "RTOS_CHIP": "stm32f103",
        "RTOS_QEMU": "C:/opt/qemu-stm32h5/qemu-system-arm.exe",
        "RTOS_RENODE": "C:/opt/renode/renode.exe"
      }
    }
,
    {
      "name": "arm-h743",
      "inherits": "arm-base",
      "displayName": "STM32H743 firmware for the emulators (QEMU, Renode) + emulator tests",
      "binaryDir": "${sourceDir}/build/arm-h743",
      "cacheVariables": {
        "RTOS_CHIP": "stm32h743",
        "RTOS_QEMU": "C:/opt/qemu-stm32h5/qemu-system-arm.exe",
        "RTOS_RENODE": "C:/opt/renode/renode.exe",
        "RTOS_NET_SNTP_PORT": "12300",
        "RTOS_NET_STATIC_FALLBACK": "192.168.77.2/24,192.168.77.1",
        "RTOS_NET_WS_PING_MS": "4000",
        "RTOS_NET_WS_PONG_TIMEOUT_MS": "3000"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "linux-afl",
      "configurePreset": "linux-afl"
    },
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-coverage",
      "configurePreset": "host-coverage"
    },
    {
      "name": "arm",
      "configurePreset": "arm"
    },
    {
      "name": "board",
      "configurePreset": "board"
    },
    {
      "name": "arm-g431",
      "configurePreset": "arm-g431"
    }
,
    {
      "name": "arm-h743",
      "configurePreset": "arm-h743"
    }
,
    {
      "name": "arm-f103",
      "configurePreset": "arm-f103"
    }
  ],
  "testPresets": [
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-coverage",
      "configurePreset": "host-coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "arm",
      "configurePreset": "arm",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "arm-g431",
      "configurePreset": "arm-g431",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "arm-h743",
      "configurePreset": "arm-h743",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "arm-f103",
      "configurePreset": "arm-f103",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
